{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "veo",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "workers_dev": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
  "secrets": {
    "required": ["BETTER_AUTH_SECRET", "SENTRY_DSN"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "veo",
      "database_id": "c0d510f7-0678-4fa2-8ee8-5558d27d75e2",
      "migrations_dir": "migrations",
    },
  ],
}
