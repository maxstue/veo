{
  "name": "veo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "cf:typegen": "vp exec wrangler types --include-runtime=false",
    "db:check": "vp exec drizzle-kit check",
    "db:generate": "vp exec drizzle-kit generate",
    "db:migrate:local": "vp exec wrangler d1 migrations apply veo --local",
    "db:migrate:remote": "vp exec wrangler d1 migrations apply veo --remote",
    "dev": "infisical run --env=dev --path=/ --watch -- vp dev",
    "generate-routes": "tsr generate",
    "release": "release-it",
    "test:e2e": "playwright test",
    "test:e2e:infisical": "infisical run --env=dev --path=/ -- vp run test:e2e",
    "test:e2e:coverage": "vp run test:e2e && vp run test:e2e:coverage-report",
    "test:e2e:coverage-report": "nyc report --temp-dir .nyc_output --report-dir coverage/e2e --reporter=lcov --reporter=text-summary --exclude-after-remap=false",
    "test:e2e:server": "vp run db:migrate:local && vp dev",
    "test:coverage": "vp test --coverage",
    "deploy": "vp build && vp exec wrangler deploy --keep-vars",
    "prepare": "vp config"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@better-auth/drizzle-adapter": "catalog:",
    "@fontsource-variable/inter": "catalog:",
    "@fontsource-variable/space-grotesk": "catalog:",
    "@sentry/cloudflare": "catalog:",
    "@sentry/tanstackstart-react": "catalog:",
    "@shadcn/react": "^0.3.0",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-devtools": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@tanstack/react-start": "catalog:",
    "better-auth": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "drizzle-orm": "catalog:",
    "immer": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@csmith/release-it-calver-plugin": "catalog:",
    "@babel/core": "catalog:",
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@playwright/test": "catalog:",
    "@rolldown/plugin-babel": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "@tanstack/devtools-vite": "catalog:",
    "@tanstack/eslint-plugin-router": "catalog:",
    "@tanstack/router-cli": "catalog:",
    "@types/babel__core": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "babel-plugin-react-compiler": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "nyc": "catalog:",
    "auto-changelog": "catalog:",
    "release-it": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-istanbul": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.18.0",
      "onFail": "download"
    }
  }
}
