{
  "name": "veo",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "cf:typegen": "vp exec wrangler types --include-runtime=false",
    "db:check": "vp exec drizzle-kit check",
    "db:generate": "vp exec drizzle-kit generate",
    "db:migrate:local": "vp exec wrangler d1 migrations apply veo --local",
    "db:migrate:remote": "vp exec wrangler d1 migrations apply veo --remote",
    "fmt": "vp fmt --write",
    "fmt:check": "vp fmt --check",
    "generate-routes": "tsr generate",
    "lint": "vp lint",
    "test:e2e": "playwright test",
    "test:e2e:server": "vp run db:migrate:local && vp dev",
    "deploy": "vp build && vp exec wrangler deploy --keep-vars",
    "prepare": "vp config"
  },
  "dependencies": {
    "@base-ui/react": "catalog:",
    "@better-auth/drizzle-adapter": "catalog:",
    "@fontsource-variable/inter": "catalog:",
    "@fontsource-variable/space-grotesk": "catalog:",
    "@sentry/tanstackstart-react": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-devtools": "catalog:",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-devtools": "catalog:",
    "@tanstack/react-start": "catalog:",
    "better-auth": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "drizzle-orm": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "shadcn": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "catalog:",
    "@cloudflare/workers-types": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/typography": "catalog:",
    "@tanstack/devtools-vite": "catalog:",
    "@tanstack/router-cli": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "drizzle-kit": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.18.0",
      "onFail": "download"
    }
  }
}
