# Copy this file to .env and replace the placeholder with a random value
# containing at least 32 characters. Never commit .env.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Email service
RESEND_API_KEY=

# Public Sentry routing key embedded into the browser build.
VITE_SENTRY_DSN=

# Public Sentry routing key read by the Cloudflare Worker at runtime.
SENTRY_DSN=
